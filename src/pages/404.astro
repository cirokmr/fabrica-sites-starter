---
import Layout from '../layouts/Layout.astro';
---

<Layout titulo="Página não encontrada" descricao="A página que você procurou não existe ou mudou de endereço." semIndex>
  <section class="secao">
    <div class="container-site max-w-xl text-center">
      <p class="text-6xl font-extrabold text-primaria">404</p>
      <h1 class="mt-4 text-3xl font-bold">Página não encontrada</h1>
      <p class="mt-3 text-suave">O endereço pode ter mudado quando renovamos o site.</p>
      <a href="/" class="botao mt-8">Voltar para o início</a>
    </div>
  </section>
</Layout>
