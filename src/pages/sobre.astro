---
import Layout from '../layouts/Layout.astro';
import Sobre from '../components/Sobre.astro';
import CTA from '../components/CTA.astro';
import site from '../data/site.json';

const pagina = site.paginas.sobre;
const { cta } = site.home;
---

<Layout titulo="Sobre" descricao={pagina.descricao_seo}>
  <section class="bg-fundo-alt">
    <div class="container-site py-14">
      <h1 class="text-4xl font-extrabold sm:text-5xl">{pagina.titulo}</h1>
    </div>
  </section>
  <Sobre titulo="Nossa história" texto={pagina.paragrafos} imagem={pagina.imagem} imagemAlt={pagina.titulo} />
  <CTA titulo={cta.titulo} texto={cta.texto} botaoTexto={cta.botao_texto} />
</Layout>
