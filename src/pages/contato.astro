---
import Layout from '../layouts/Layout.astro';
import Contato from '../components/Contato.astro';
import site from '../data/site.json';

const pagina = site.paginas.contato;
---

<Layout titulo="Contato" descricao={pagina.descricao_seo}>
  <section class="bg-fundo-alt">
    <div class="container-site py-14">
      <h1 class="text-4xl font-extrabold sm:text-5xl">{pagina.titulo}</h1>
    </div>
  </section>
  <Contato />
</Layout>
