---
// Página inicial = uma sequência de seções. Para mudar a ordem, mude a ordem aqui.
// Todo o texto vem de src/data/site.json -> "home".
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Servicos from '../components/Servicos.astro';
import Sobre from '../components/Sobre.astro';
import Depoimentos from '../components/Depoimentos.astro';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';
import site from '../data/site.json';

const { hero, servicos, sobre, depoimentos, faq, cta } = site.home;
---

<Layout>
  <Hero
    titulo={hero.titulo}
    subtitulo={hero.subtitulo}
    botaoTexto={hero.botao_texto}
    botaoLink={hero.botao_link}
    imagem={hero.imagem}
  />
  <Servicos titulo={servicos.titulo} itens={servicos.itens} fundoAlt />
  <Sobre titulo={sobre.titulo} texto={sobre.texto} imagem={sobre.imagem} link={sobre.link} />
  <Depoimentos itens={depoimentos} />
  <FAQ itens={faq} />
  <CTA titulo={cta.titulo} texto={cta.texto} botaoTexto={cta.botao_texto} />
</Layout>
