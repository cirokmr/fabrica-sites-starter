---
// Bloco de texto + imagem lado a lado (vira coluna única no celular).
interface Props {
  titulo: string;
  texto: string[];          // um item por parágrafo
  imagem?: string;
  imagemAlt?: string;
  link?: string;
  linkTexto?: string;
  imagemADireita?: boolean;
}
const { titulo, texto, imagem, imagemAlt = '', link, linkTexto = 'Conheça nossa história', imagemADireita = true } = Astro.props;
---

<section class="secao">
  <div class:list={['container-site grid items-center gap-10', imagem && 'md:grid-cols-2']}>
    <div class:list={[imagem && !imagemADireita && 'md:order-2']}>
      <h2 class="text-3xl font-bold sm:text-4xl">{titulo}</h2>
      <div class="mt-5 space-y-4 text-lg leading-relaxed text-suave">
        {texto.map((p) => <p>{p}</p>)}
      </div>
      {link && <a href={link} class="botao mt-8">{linkTexto}</a>}
    </div>
    {imagem && <img src={imagem} alt={imagemAlt} loading="lazy" class="w-full rounded-2xl object-cover shadow-md" />}
  </div>
</section>
