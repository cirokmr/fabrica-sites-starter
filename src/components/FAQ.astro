---
// Perguntas frequentes em sanfona (<details>), sem JavaScript.
// Também gera o Schema.org FAQPage, que pode aparecer direto no Google.
interface Pergunta { pergunta: string; resposta: string }
interface Props { titulo?: string; itens: Pergunta[] }
const { titulo = 'Perguntas frequentes', itens } = Astro.props;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: itens.map((i) => ({
    '@type': 'Question',
    name: i.pergunta,
    acceptedAnswer: { '@type': 'Answer', text: i.resposta },
  })),
};
---

{itens.length > 0 && (
  <section class="secao">
    <div class="container-site max-w-3xl">
      <h2 class="titulo-secao">{titulo}</h2>
      <div class="divide-y divide-black/10 rounded-xl border border-black/10">
        {itens.map((i) => (
          <details class="group p-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold [&::-webkit-details-marker]:hidden">
              {i.pergunta}
              <span class="text-primaria transition group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <p class="mt-3 text-suave">{i.resposta}</p>
          </details>
        ))}
      </div>
    </div>
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </section>
)}
