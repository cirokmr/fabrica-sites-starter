---
// Grade de cards (serviços, produtos, diferenciais...). Funciona com 1 a 12 itens.
interface Item { titulo: string; descricao: string; imagem?: string; link?: string }
interface Props { titulo?: string; itens: Item[]; fundoAlt?: boolean }
const { titulo, itens, fundoAlt = false } = Astro.props;
---

{itens.length > 0 && (
  <section class:list={['secao', fundoAlt && 'bg-fundo-alt']}>
    <div class="container-site">
      {titulo && <h2 class="titulo-secao">{titulo}</h2>}
      <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {itens.map((item) => (
          <li class="flex flex-col overflow-hidden rounded-xl border border-black/5 bg-white shadow-sm">
            {item.imagem && <img src={item.imagem} alt={item.titulo} loading="lazy" class="aspect-[16/10] w-full object-cover" />}
            <div class="flex flex-1 flex-col p-6">
              <h3 class="text-xl font-semibold">{item.titulo}</h3>
              <p class="mt-2 flex-1 text-suave">{item.descricao}</p>
              {item.link && <a href={item.link} class="mt-4 font-semibold">Saiba mais →</a>}
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
