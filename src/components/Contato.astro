---
// Dados de contato + formulário.
// Com site.json -> formulario.action preenchido (ex.: Formspree): formulário real.
// Sem action: mostra botões de WhatsApp e e-mail no lugar do formulário.
import site from '../data/site.json';
const { empresa, formulario } = site;
const zap = empresa.whatsapp
  ? `https://wa.me/${empresa.whatsapp.replace(/\D/g, '')}?text=${encodeURIComponent(empresa.whatsapp_mensagem || '')}`
  : '';
const campo = 'mt-1 w-full rounded-lg border border-black/15 px-4 py-3 focus:border-primaria focus:outline-none focus:ring-2 focus:ring-primaria/30';
---

<section class="secao">
  <div class="container-site grid gap-12 md:grid-cols-2">
    <div>
      <h2 class="text-2xl font-bold">Nossos contatos</h2>
      <dl class="mt-6 space-y-4">
        {empresa.telefone && <div><dt class="font-semibold">Telefone</dt><dd><a href={`tel:${empresa.telefone.replace(/\D/g, '')}`}>{empresa.telefone}</a></dd></div>}
        {zap && <div><dt class="font-semibold">WhatsApp</dt><dd><a href={zap} target="_blank" rel="noopener">Iniciar conversa</a></dd></div>}
        {empresa.email && <div><dt class="font-semibold">E-mail</dt><dd><a href={`mailto:${empresa.email}`}>{empresa.email}</a></dd></div>}
        {empresa.endereco && <div><dt class="font-semibold">Endereço</dt><dd class="text-suave">{empresa.endereco}</dd></div>}
        {empresa.horario && <div><dt class="font-semibold">Horário</dt><dd class="text-suave">{empresa.horario}</dd></div>}
      </dl>
    </div>

    {formulario.action ? (
      <form action={formulario.action} method="POST" class="space-y-4 rounded-xl bg-fundo-alt p-6">
        <label class="block">Nome<input name="nome" required autocomplete="name" class={campo} /></label>
        <label class="block">E-mail<input name="email" type="email" required autocomplete="email" class={campo} /></label>
        <label class="block">Telefone<input name="telefone" type="tel" autocomplete="tel" class={campo} /></label>
        <label class="block">Mensagem<textarea name="mensagem" rows="4" required class={campo}></textarea></label>
        <button type="submit" class="botao w-full">Enviar mensagem</button>
      </form>
    ) : (
      <div class="flex flex-col justify-center gap-4 rounded-xl bg-fundo-alt p-8 text-center">
        <p class="text-lg">Prefere falar agora?</p>
        {zap && <a href={zap} target="_blank" rel="noopener" class="botao">Chamar no WhatsApp</a>}
        {empresa.email && <a href={`mailto:${empresa.email}`} class="font-semibold">ou envie um e-mail</a>}
      </div>
    )}
  </div>
</section>
