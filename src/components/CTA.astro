---
// Faixa de chamada para ação. Sem "link", aponta para o WhatsApp do cliente.
import site from '../data/site.json';
interface Props { titulo: string; texto?: string; botaoTexto: string; link?: string }
const { titulo, texto, botaoTexto, link } = Astro.props;
const { whatsapp, whatsapp_mensagem } = site.empresa;
const destino = link
  || (whatsapp ? `https://wa.me/${whatsapp.replace(/\D/g, '')}?text=${encodeURIComponent(whatsapp_mensagem || '')}` : '/contato');
const externo = destino.startsWith('http');
---

<section class="bg-primaria text-white">
  <div class="container-site flex flex-col items-center gap-6 py-16 text-center">
    <h2 class="text-3xl font-bold text-white sm:text-4xl">{titulo}</h2>
    {texto && <p class="max-w-xl text-lg text-white/90">{texto}</p>}
    <a href={destino} class="botao-secundario" target={externo ? '_blank' : undefined} rel={externo ? 'noopener' : undefined}>{botaoTexto}</a>
  </div>
</section>
